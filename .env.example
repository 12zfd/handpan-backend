# 本地开发：不填 DATABASE_URL 会自动用 SQLite（data/handpan.db）
# 生产（Render）：把 PostgreSQL 的 Internal Database URL 粘过来
DATABASE_URL=

# 生产必须改成随机长串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-before-deploy

# 识别引擎：handpan（默认，轻量）| basic_pitch（需另装 basic-pitch）
TRANSCRIBE_ENGINE=handpan

# 截图识别：off（默认关闭，前端手动录入）| oemer
OMR_ENGINE=off

# 对象存储：留空则落本地 data/ 目录；生产请配 R2/S3
S3_BUCKET=
S3_ENDPOINT=
S3_KEY=
S3_SECRET=
S3_REGION=auto

# 跨域（Render 三服务部署时填前端域名，逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000
